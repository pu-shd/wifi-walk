#!/bin/sh
# Test stand-in for sudo: drop options and run the command (if any) "as root",
# i.e. with WIFI_WALK_ASSUME_ROOT=1. Calls are logged to $MOCK_STATE.sudo.
# MOCK_SUDO_FAIL=1 acts like a user who isn't in sudoers.
[ -n "${MOCK_STATE:-}" ] && echo "$*" >> "$MOCK_STATE.sudo"
if [ "${MOCK_SUDO_FAIL:-0}" = 1 ]; then
  echo "$(id -un) is not in the sudoers file." >&2; exit 1
fi
while [ $# -gt 0 ]; do
  case $1 in -*) shift ;; *) break ;; esac
done
[ $# -eq 0 ] && exit 0
WIFI_WALK_ASSUME_ROOT=1 MOCK_SUDO_FAIL=0 exec "$@"
