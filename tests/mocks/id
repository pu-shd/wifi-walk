#!/bin/sh
# Test stand-in for id. "id -Gn" prints $MOCK_GROUPS (default "staff admin");
# "id -u NAME" knows only the accounts in $MOCK_USERS (default "admin").
# Anything else goes to the real id.
case "$1" in
  -Gn) echo "${MOCK_GROUPS:-staff admin}"; exit 0 ;;
  -u)
    if [ $# -gt 1 ]; then
      [ "$2" = -- ] && shift
      for u in ${MOCK_USERS:-admin}; do [ "$u" = "$2" ] && { echo 502; exit 0; }; done
      echo "id: $2: no such user" >&2; exit 1
    fi ;;
esac
for d in /usr/bin /bin; do [ -x "$d/id" ] && exec "$d/id" "$@"; done
